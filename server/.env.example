# Copie para .env (ou exporte no ambiente) e preencha o que for usar.
# NUNCA faça commit do arquivo .env com valores reais.

# Porta do servidor
PORT=8787

# Caminho do banco SQLite (precisa de disco persistente em produção)
DB_PATH=./data/turbocanal.db

# E-mail do administrador principal (owner). O cadastro com esse e-mail NÃO vira admin sozinho:
# é preciso reivindicar com o TOKEN DE SETUP impresso no console na primeira execução,
# ou entrar via Login com Google com esse e-mail verificado.
OWNER_EMAIL=lcmatias777@gmail.com

# Defina como 1 quando o site estiver atrás de HTTPS (cookies Secure)
COOKIE_SECURE=0

# URL pública do site (usada no OAuth do Google e nos webhooks)
BASE_URL=http://localhost:8787

# --- YouTube Data API v3 (obrigatória para dados reais do YouTube) ---
# Crie em https://console.cloud.google.com > APIs e serviços > Credenciais > Chave de API
# e ative a "YouTube Data API v3". Também pode ser configurada em Admin > Configurações.
YT_API_KEY=

# --- Login com Google (opcional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Mercado Pago (Pix) ---
# Access Token (use o de TESTE primeiro): https://www.mercadopago.com.br/developers
# Sem isso, a página de pagamentos mostra que os pagamentos ainda não foram ativados.
MP_ACCESS_TOKEN=

# --- IA (opcional) ---
# Com uma chave da API da Anthropic, os títulos/descrições usam IA de verdade;
# sem chave, o sistema usa um gerador heurístico e avisa o usuário.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Somente para testes automatizados ---
# YT_MOCK=1 faz as ferramentas de YouTube devolverem dados de exemplo ROTULADOS como teste.
# Nunca use em produção.
YT_MOCK=0
