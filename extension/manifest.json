{
  "manifest_version": 3,
  "name": "TurboCanal para YouTube",
  "version": "1.0.2",
  "description": "VPH, outliers, SEO e tags em qualquer vídeo do YouTube, com painel no vídeo, na busca, no canal e no Studio.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TurboCanal",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "activeTab", "cookies"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["page-data.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://studio.youtube.com/*"],
      "js": ["studio.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://turbocanal.onrender.com/*"]
}
