{
  "manifest_version": 3,
  "name": "TurboCanal para YouTube",
  "version": "0.4.1",
  "description": "Painel do TurboCanal direto no YouTube: SEO do vídeo, tags, estatísticas, atalhos para o seu canal. Mesma conta do site (login com Google).",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TurboCanal",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "cookies"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://turbocanal.onrender.com/*"
  ]
}
